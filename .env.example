CONTENT_SOURCE=fixture
CONTENT_API_BASE_URL=

# Tin tức lấy từ admin PHP (InfinityFree). Để trống để tiếp tục dùng Sanity.
# NEWS_SOURCE=php
NEWS_SOURCE=
NEWS_API_BASE_URL=
# Proxy ảnh /media/* sang host admin, ví dụ https://gisa.gt.tc
CONTENT_MEDIA_ORIGIN=

# Form submissions are accepted only after this receiver is configured.
# The endpoint must return a 2xx response for GISA to show a success message.
GISA_FORM_WEBHOOK_URL=
# Optional shared secret forwarded as X-GISA-Webhook-Secret.
GISA_FORM_WEBHOOK_SECRET=
